# Nukopijuokite į .env ir pakeiskite reikšmes.

# Portas, kuriuo veikia programa
PORT=3000

# Pilnas svetainės adresas (naudojamas nuorodoms, sitemap.xml, Facebook peržiūroms)
SITE_URL=https://www.kdlegacy.lt

# production – įjungia HTTPS slapukus, kešavimą ir HSTS (naudokite už HTTPS)
NODE_ENV=production

# Kur laikomi duomenys: SQLite duomenų bazė ir įkeltos nuotraukos.
# SVARBU: šį katalogą reikia daryti atsargines kopijas.
DATA_DIR=./data

# Pirmasis administratorius sukuriamas tik tada, kai duomenų bazėje dar nėra vartotojų.
# Jei slaptažodžio nenurodysite – jis bus sugeneruotas ir parodytas konsolėje.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Sesijų slaptasis raktas. Jei tuščias – sugeneruojamas ir išsaugomas DATA_DIR kataloge.
SESSION_SECRET=

# Kiek proxy serverių yra prieš programą (Nginx, Caddy, Railway...). 1 – dažniausias atvejis.
TRUST_PROXY=1

# Didžiausi įkeliamų failų dydžiai (MB)
MAX_IMAGE_MB=20
MAX_VIDEO_MB=150

# El. laiškai apie naujas registracijas (nebūtina).
# Pvz. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=jusu@gmail.com, SMTP_PASS=<„App password“ iš Google paskyros>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

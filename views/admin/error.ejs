<!doctype html>
<html lang="lt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> · <%= s.site_name || 'KD Legacy' %></title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="<%= asset('/css/admin.css') %>">
</head>
<body class="auth">
<%- include('../partials/logo-sprite') %>
  <main class="auth__card">
    <p class="auth__logo"><%- logoSvg('auth__logo-svg', s.site_name || 'KD Legacy') %></p>
    <h1 class="auth__title"><%= title %></h1>
    <p class="muted"><%= message %></p>
    <p><a class="btn btn--primary btn--block" href="/admin">Grįžti į valdymo panelę</a></p>
  </main>
</body>
</html>

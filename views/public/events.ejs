<%- include('partials/head') %>
<%- include('partials/page-head', { heading: t('events.pageTitle') }) %>

<section class="section section--tight">
  <div class="container">
    <h2 class="h3"><%= t('events.upcoming') %></h2>
    <% if (upcoming.length) { %>
      <ul class="event-list">
        <% upcoming.forEach((e) => { %><%- include('partials/event-row', { e }) %><% }) %>
      </ul>
    <% } else { %>
      <p class="empty"><%= t('events.empty') %></p>
    <% } %>

    <% if (past.length) { %>
      <h2 class="h3 h3--spaced"><%= t('events.past') %></h2>
      <ul class="event-list event-list--past">
        <% past.forEach((e) => { %><%- include('partials/event-row', { e }) %><% }) %>
      </ul>
    <% } %>
  </div>
</section>

<%- include('partials/foot') %>
